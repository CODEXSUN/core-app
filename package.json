{
  "name": "@workspace/core-app",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "node --watch src/api/server.ts",
    "start": "node src/api/server.ts",
    "preflight": "node scripts/preflight.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts tools/*.test.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:versions",
    "github:now": "node tools/github-helper.mjs",
    "github:audit": "node tools/github-helper.mjs --dry-run",
    "github:ssh-key": "node tools/github-ssh-key.mjs",
    "version:show": "node tools/check-versions.mjs",
    "version:update": "node tools/version-bump.mjs",
    "version:bump": "node tools/version-bump.mjs",
    "version:preview": "node tools/version-bump.mjs --dry-run",
    "check:versions": "node tools/check-versions.mjs",
    "db:status": "node scripts/database.ts status",
    "db:migrate": "node scripts/database.ts migrate",
    "db:rollback": "node scripts/database.ts rollback",
    "db:seed": "node scripts/database.ts seed",
    "test:database": "node --env-file=.env.test --test --test-concurrency=1 src/api/modules/*/*/tests/*.test.ts tests/core-modules.database.ts",
    "client:create": "node scripts/create-api-client.ts",
    "dev:api": "node --watch src/api/server.ts",
    "dev:web": "vite"
  },
  "dependencies": {
    "@workspace/framework": "file:../../foundation/framework",
    "@workspace/ui": "file:../../packages/ui",
    "fastify": "5.12.8",
    "kysely": "0.29.9",
    "lucide-react": "1.73.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7",
    "@workspace/sdk": "file:../../packages/sdk"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "exports": {
    "./legacy-contact": "./contracts/legacy-contact-port.ts",
    "./contracts/legacy-contact": "./contracts/legacy-contact.ts",
    "./client": "./contracts/client.ts",
    "./contracts/billing-context": "./contracts/billing-context.ts",
    "./contracts/organisation-context": "./contracts/organisation-context.ts",
    "./contracts/country": "./contracts/country.ts",
    "./contracts/state": "./contracts/state.ts",
    "./contracts/district": "./contracts/district.ts",
    "./contracts/city": "./contracts/city.ts",
    "./contracts/pincode": "./contracts/pincode.ts",
    "./contracts/ledger-group": "./contracts/ledger-group.ts",
    "./contracts/ledger": "./contracts/ledger.ts",
    "./contracts/address-type": "./contracts/address-type.ts",
    "./contracts/bank-name": "./contracts/bank-name.ts",
    "./contracts/contact-group": "./contracts/contact-group.ts",
    "./contracts/contact-type": "./contracts/contact-type.ts",
    "./contracts/currency": "./contracts/currency.ts",
    "./contracts/month": "./contracts/month.ts",
    "./contracts/payment-term": "./contracts/payment-term.ts",
    "./contracts/priority": "./contracts/priority.ts",
    "./contracts/sales-type": "./contracts/sales-type.ts",
    "./contracts/brand": "./contracts/brand.ts",
    "./contracts/colour": "./contracts/colour.ts",
    "./contracts/hsn-code": "./contracts/hsn-code.ts",
    "./contracts/product-category": "./contracts/product-category.ts",
    "./contracts/product-group": "./contracts/product-group.ts",
    "./contracts/product-type": "./contracts/product-type.ts",
    "./contracts/size": "./contracts/size.ts",
    "./contracts/style": "./contracts/style.ts",
    "./contracts/tax": "./contracts/tax.ts",
    "./contracts/unit": "./contracts/unit.ts",
    "./contracts/destination": "./contracts/destination.ts",
    "./contracts/stock-rejection-type": "./contracts/stock-rejection-type.ts",
    "./contracts/transport": "./contracts/transport.ts",
    "./contracts/warehouse": "./contracts/warehouse.ts",
    "./contracts/work-order-type": "./contracts/work-order-type.ts",
    "./contracts/company": "./contracts/company.ts",
    "./contracts/financial-year": "./contracts/financial-year.ts",
    "./contracts/contact": "./contracts/contact.ts",
    "./contracts/product": "./contracts/product.ts",
    "./contracts/work-order": "./contracts/work-order.ts",
    "./contracts/default-company": "./contracts/default-company.ts"
  }
}
