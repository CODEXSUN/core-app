NODE_ENV=development
CORE_APP_HOST=127.0.0.1
CORE_APP_PORT=4345
CORE_APP_LOG_LEVEL=info
CORE_APP_SHUTDOWN_TIMEOUT_MS=10000

CORE_APP_DATABASE_URL=

# Opt in only for local development on loopback. Never enable in production.
CORE_APP_LOCAL_ACCESS=false
# JSON array of {tokenHash, actorId, tenantId, permissions}; hashes are SHA-256.
CORE_APP_API_CLIENTS=[]
# Exact browser origin, including scheme and port.
CORE_APP_PUBLIC_ORIGIN=http://127.0.0.1:4340

CORE_APP_WEB_PORT=4340
